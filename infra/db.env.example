# ==============================================================================
# CredKeep V2 — Local PostgreSQL Infrastructure Environment Configuration
# ==============================================================================
# Copy this template to infra/db.env and set your local database secrets:
#   cp infra/db.env.example infra/db.env
#
# NOTE: infra/db.env is git-ignored and must NEVER be committed to version control.
# NOTE: Do NOT use production or staging credentials in local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL 15 Database Configuration (Container: credkeep_db)
# ------------------------------------------------------------------------------
# Local PostgreSQL database name
POSTGRES_DB=credkeep_v2

# Superuser / migration role name
POSTGRES_USER=postgres

# Superuser / migration role password (required for local schema migrations)
POSTGRES_PASSWORD=replace_with_strong_dev_postgres_password

# Host port for PostgreSQL (bound strictly to 127.0.0.1 on the host machine)
# Defaults to 5434 to prevent collisions with any native local PostgreSQL on 5432
DB_PORT=5434

# ------------------------------------------------------------------------------
# 2. Restricted Application Database Role (Role: credkeep_app)
# ------------------------------------------------------------------------------
# Least-privilege runtime role used by Django backend (enforces PostgreSQL RLS)
APP_DB_USER=credkeep_app

# Application role password (provisioned on init via backend/init-db.sql)
APP_DB_PASSWORD=replace_with_strong_dev_app_password

# ------------------------------------------------------------------------------
# 3. Docker Internal Connection Strings (for Docker Compose network)
# ------------------------------------------------------------------------------
# Privileged migration connection string (used by one-off migration container)
MIGRATION_DATABASE_URL=postgres://postgres:replace_with_strong_dev_postgres_password@db:5432/credkeep_v2

# Restricted runtime connection string (used by Django backend inside Docker)
APP_DATABASE_URL=postgres://credkeep_app:replace_with_strong_dev_app_password@db:5432/credkeep_v2
