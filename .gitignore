# --------------------------------------------------
# React Native & Expo .gitignore for CredKeep
# --------------------------------------------------

# Dependencies
node_modules/
package-lock.json.orig
npm-debug.*
yarn-debug.*
yarn-error.*

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native builds & generated folders (Continuous Native Generation)
/ios/
/android/
.kotlin/
*.orig.*

# Environment variables & secrets
.env
.env.*
!.env.example
credentials.json
google-services.json
GoogleService-Info.plist

# Keystores, signing keys & certificates
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# Databases & local offline storage
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Encrypted backups, snapshots & user vault files
*.bak
*.backup
*.enc
*.credkeep.enc
/vault/
/data/
/backups/

# User documents & receipts (PDF/media exports)
*.pdf
/exports/
/receipts/

# Metro & Bundler
.metro-health-check*

# TypeScript
*.tsbuildinfo

# OS & Editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Scratch & Project Tasks
# Allow markdown issues and specs under .scratch/ while ignoring temp binaries
.scratch/**/*.tmp
.scratch/**/*.log

# Temporary workflow diagnostic and generated files
graphify-out/
test-bug.js
.workflow/qa_prompt.txt

# Python & Django
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
backend/.venv/
*.sqlite3
.pytest_cache/
.coverage
htmlcov/

