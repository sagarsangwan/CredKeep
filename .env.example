# ==============================================================================
# CredKeep V1/V2 — Mobile & Local Development Environment Configuration
# ==============================================================================
# Copy this template to .env:
#   cp .env.example .env
#
# NOTE: Never commit .env files to version control. .env is git-ignored.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Backend API Endpoint (Expo Public Variable)
# ------------------------------------------------------------------------------
# Option A — Android Emulator (Default in __DEV__):
#   Leave EXPO_PUBLIC_API_URL unset; defaults to http://10.0.2.2:8000/api/v2
#
# Option B — Physical Android Device via ADB Reverse:
#   Run: adb reverse tcp:8000 tcp:8000
#   Set: EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v2
#
# Option C — Physical Android Device on Same Wi-Fi:
#   Set: EXPO_PUBLIC_API_URL=http://192.168.1.50:8000/api/v2
#
# Option D — Hosted Staging / Production Backend:
#   Set: EXPO_PUBLIC_API_URL=https://your-service.onrender.com/api/v2
EXPO_PUBLIC_API_URL=

# ------------------------------------------------------------------------------
# 2. Google OAuth Configuration
# ------------------------------------------------------------------------------
# Google Web OAuth Client ID used by the Expo mobile app and the Django backend.
# The mobile Google Sign-In prompt requests ID tokens targeting this Web Client ID as audience.
#
# Format: your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID=replace_with_google_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=replace_with_google_web_client_id.apps.googleusercontent.com

# SECURITY NOTICE:
# - Android OAuth Client: Registered in Google Cloud Console with:
#     Package Name: com.sagarsangwan.credkeep
#     Signing SHA-1: From your keystore / EAS credentials
# - Web Client Secret: Retained securely in Google Cloud Console / backend hosting secrets.
#   NEVER include Web Client Secret in mobile app configuration, source control, or Expo public variables.
