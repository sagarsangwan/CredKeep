# ==============================================================================
# CredKeep V2 — Backend Local Development Environment Configuration
# ==============================================================================
# Copy this template to backend/.env and fill in your local development secrets:
#   cp backend/.env.example backend/.env
#
# NOTE: Never commit .env files to version control. backend/.env is git-ignored.
# NOTE: Do NOT use production secrets in local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL 15 Configuration (Container: credkeep_db)
# ------------------------------------------------------------------------------
POSTGRES_DB=credkeep_v2
POSTGRES_USER=postgres
# Admin password for PostgreSQL superuser (required, no default fallback)
POSTGRES_PASSWORD=replace_with_strong_dev_postgres_password

# Host port for PostgreSQL (bound strictly to 127.0.0.1 on the host machine)
# Defaults to 5433 to avoid colliding with any native local PostgreSQL on 5432
DB_PORT=5433

# ------------------------------------------------------------------------------
# 2. Restricted Application Database Credentials (Role: credkeep_app)
# ------------------------------------------------------------------------------
# Restricted role used for runtime Django queries (enforces Row Level Security)
APP_DB_USER=credkeep_app
# Application password (required, no default fallback)
APP_DB_PASSWORD=replace_with_strong_dev_app_password

# ------------------------------------------------------------------------------
# 3. Django REST Framework Backend Configuration (Container: credkeep_backend)
# ------------------------------------------------------------------------------
# Django secret key (required, no insecure default fallback)
SECRET_KEY=replace_with_a_random_django_secret_key_for_local_dev

# Set to True ONLY for local development; False in production/staging
DEBUG=True

# Container port (internal to Docker network, mapped to host PORT)
PORT=8000

# Allowed hosts for Django (comma-separated, no wildcards)
# Automatically supports localhost, 127.0.0.1, Docker network service names,
# and Android emulator loopback (10.0.2.2).
ALLOWED_HOSTS=localhost,127.0.0.1,backend,10.0.2.2,host.docker.internal

# Optional: developer workstation LAN IP for testing from a physical Android device on the same Wi-Fi
# Example: LAN_IP=192.168.1.50
LAN_IP=

# ------------------------------------------------------------------------------
# 4. Database Connection Strings
# ------------------------------------------------------------------------------
# For Django running inside Docker Compose:
# (Uses service hostname 'db' and restricted application credentials)
# Format: postgres://${APP_DB_USER}:${APP_DB_PASSWORD}@db:5432/${POSTGRES_DB}
DATABASE_URL=postgres://credkeep_app:replace_with_strong_dev_app_password@db:5432/credkeep_v2

# For migrations running inside Docker Compose:
# (The 'migration' service automatically uses POSTGRES_USER credentials)
# Format: postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# For connecting from host tools (e.g., DBeaver, TablePlus, psql) via port 5433:
# postgres://credkeep_app:replace_with_strong_dev_app_password@127.0.0.1:5433/credkeep_v2

# ------------------------------------------------------------------------------
# 5. Mobile Client Connection (React Native / Expo App)
# ------------------------------------------------------------------------------
# The mobile client resolves its API URL based on EXPO_PUBLIC_API_URL:
#
# Option A — Android Emulator (Default in __DEV__):
#   Leave EXPO_PUBLIC_API_URL unset; defaults automatically to:
#   http://10.0.2.2:8000/api/v2
#
# Option B — Physical Android Device via ADB Reverse:
#   1. Connect device with USB debugging enabled.
#   2. Run: adb reverse tcp:8000 tcp:8000
#   3. Set: EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
#
# Option C — Physical Android Device on Same Wi-Fi Network:
#   1. Find your computer's LAN IP (e.g. 192.168.1.50).
#   2. Add LAN IP to LAN_IP in backend/.env above.
#   3. Set: EXPO_PUBLIC_API_URL=http://192.168.1.50:8000
#
# Option D — Hosted Staging Backend (Render):
#   Set: EXPO_PUBLIC_API_URL=https://your-service.onrender.com
#
# In production/staging builds (__DEV__=false), EXPO_PUBLIC_API_URL is strictly
# required and will fail closed if missing.
EXPO_PUBLIC_API_URL=

# ------------------------------------------------------------------------------
# 6. Docker Operations & Verification Quick Reference
# ------------------------------------------------------------------------------
# Start services (from repository root):
#   docker compose -f infra/docker-compose.yml up -d
#
# View backend logs:
#   docker compose -f infra/docker-compose.yml logs -f backend
#
# Check service status:
#   docker compose -f infra/docker-compose.yml ps
#
# Verify Django health & database readiness:
#   curl http://127.0.0.1:8000/api/v2/health/   # {"status":"ok"}
#   curl http://127.0.0.1:8000/api/v2/ready/    # {"status":"ready"}
#
# Run migrations manually (if needed outside Docker Compose):
#   docker compose -f infra/docker-compose.yml run --rm migration
#
# Stop services (preserves persistent postgres_data volume):
#   docker compose -f infra/docker-compose.yml down
#   CAUTION: Never use 'docker compose down -v' as that deletes persistent volumes.
#
# NOTE: Render Staging vs Local Docker:
#   Local development uses Docker Compose with PostgreSQL 15 container.
#   Render deployment uses native Python runtime (render.yaml) and managed DB.
#   Do not modify render.yaml or production environment variables for local ops.
# ==============================================================================
